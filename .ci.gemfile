# This file is only used for CI.

source 'http://rubygems.org'

gem 'rake'
gem 'hexspace'
gem 'sequel'
gem 'minitest-hooks'
gem 'minitest-global_expectations'
gem 'simplecov'

# thrift 0.22.0 requires base64 but doesn't declare it; removed from default gems in Ruby 3.4
gem 'base64'
# logger removed from default gems in Ruby 4.0
gem 'logger'
